# ==========================================
# Who's Who - Variabili d'Ambiente di Esempio
# Copia questo file in '.env' e personalizza i valori:
#   cp .env.example .env
# ==========================================

# Configurazione MySQL
MYSQL_ROOT_PASSWORD=root_supersecret
MYSQL_DATABASE=whoswho_db
MYSQL_USER=whoswho_user
MYSQL_PASSWORD=whoswho_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Porta locale per esporre MySQL sulla macchina host (es. per DBeaver/Workbench)
HOST_MYSQL_PORT=3306

# Configurazione Applicazione
APP_ENV=development
APP_LOG_LEVEL=INFO
