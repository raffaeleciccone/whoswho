# ==========================================
# Who's Who - variabili d'ambiente
# Copia questo file in '.env' e cambia le password:
#   cp .env.example .env
# ==========================================

# MySQL
MYSQL_ROOT_PASSWORD=cambiami_root
MYSQL_DATABASE=whoswho_db
MYSQL_USER=whoswho_user
MYSQL_PASSWORD=cambiami

# Database usato dai test (creato da db/crea-db-test.sh)
MYSQL_TEST_DATABASE=whoswho_test

# Porte sul tuo PC
# 3307 per DBeaver/Workbench (non 3306, per non scontrarsi con un MySQL locale)
HOST_MYSQL_PORT=3307
# pagina web: http://localhost:8000
HOST_APP_PORT=8000

# Al primo avvio, se il database è vuoto, carica le persone finte di dati/esempio.json
CARICA_ESEMPIO=1
